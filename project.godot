config_version=5

[application]
config/name="Rajd przez Polskę"
run/main_scene="res://src/scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0196, 0.0431, 0.0196, 1)
boot_splash/fullsize=false
boot_splash/image="res://assets/brand/muutex_logo.png"

[audio]

driver/output_latency.web=150

[autoload]
Session="*res://src/autoload/session.gd"
Sfx="*res://src/autoload/sfx.gd"
Screen="*res://src/autoload/screen.gd"

[display]

window/dpi/allow_hidpi=false
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

